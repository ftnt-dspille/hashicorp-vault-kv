# HashiCorp Vault KV live-test credentials. Copy to tests/.env (same
# directory) and fill in. tests/.env is gitignored - never commit real
# credentials.
#
# When running alongside the sibling fortinet-fortiaigate checkout, the
# live tests reuse its tests/.env by default; only fill this in to override.

VAULT_ADDR=https://vault.example.com:8200
VAULT_TOKEN=<your-token>
VAULT_MOUNT=secret
VAULT_SECRET_PATH=secret/myapp/api
